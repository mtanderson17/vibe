{
  "name": "vibe",
  "version": "0.0.1",
  "description": "Command center for agent-driven development",
  "author": "mtanderson17",
  "license": "MIT",
  "homepage": "https://github.com/mtanderson17/vibe",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-tests.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke.mjs --packaged",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "//overrides": "monaco-editor pins dompurify to an exact 3.4.8, which has four XSS advisories (fixed in 3.4.15) and is reachable because Monaco sanitizes the markdown it renders in hovers. The latest Monaco (0.56) still pins 3.4.8, so the alternative was downgrading Monaco three minor versions. 3.4.15 is a patch bump within the same series. Drop this once Monaco ships a patched pin.",
  "overrides": {
    "dompurify": "3.4.15"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.50",
    "@ai-sdk/google": "^4.0.65",
    "@ai-sdk/groq": "^4.0.38",
    "@ai-sdk/openai": "^4.0.62",
    "@ai-sdk/xai": "^4.0.55",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.94",
    "electron-store": "^8.2.0",
    "monaco-editor": "^0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.5",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  }
}
